# ==============================================================================
# NELIA Suite - Environment Configuration Template
# Copy this file to '.env' if you want to customize your setup.
# ==============================================================================

# PostgreSQL Database (Optional - Defaults work with included docker-compose.yml)
# Note: If PostgreSQL is unreachable, NELIA will automatically fall back to SQLite!
POSTGRES_USER=scriptor
POSTGRES_PASSWORD=scriptor_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scriptor_db

# Custom Database URL (overrides individual POSTGRES_* settings if provided)
# DATABASE_URL=postgresql+psycopg://scriptor:scriptor_password@localhost:5432/scriptor_db

# Local Ollama AI Engine
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b

# Internal Microservice Configuration
SCRIPT_AI_PORT=8765
